#!/bin/sh
set -eu
source_dir=$1
prefix=$2
install -d -m 755 "$prefix/bin" "$prefix/lib/draft-service"
for name in server.py registration.py desk.py team.py desk_normalize.py desk_persist.py team_normalize.py team_persist.py; do
    install -m 644 "$source_dir/$name" "$prefix/lib/draft-service/$name"
done
cat > "$prefix/bin/draft-service" <<'LAUNCHER'
#!/bin/sh
set -eu
prefix="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
exec python3 "$prefix/lib/draft-service/server.py" "$@"
LAUNCHER
chmod 755 "$prefix/bin/draft-service"
